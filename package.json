{
  "name": "salon-template",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:cenovnik": "node scripts/build-cenovnik.mjs",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --minify",
    "build:dist": "node scripts/prepare-dist.mjs",
    "build": "npm run build:cenovnik && npm run build:css && npm run build:dist",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.14",
    "@tailwindcss/cli": "^4.1.14"
  }
}
